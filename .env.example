# Copy to .env for local dev, or set these as environment variables in Railway.
# Nothing here is required for local SQLite testing except maybe SECRET_KEY.

# Database. Local dev defaults to SQLite under ./data. In production, paste the
# Supabase Postgres connection string here (Supabase -> Project Settings ->
# Database -> Connection string -> URI). "postgres://" is auto-normalized.
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxx.supabase.co:5432/postgres

# Signs the login cookie. MUST be set to a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# If set, new users must enter this code to register (keeps the sign-up private).
REGISTER_CODE=valley2026

# Store id that counts are recorded under (one store for now).
DEFAULT_STORE=valley

# Box layout. "48" = boxes numbered 1..48 (current layout).
# (Lettered units also supported, e.g. SLOTS=A:24,B:24 -> A1..A24,B1..B24.)
SLOTS=48

# The store's timezone. Scans are stored in UTC but the daily report groups by
# the LOCAL day, so a 9pm night count belongs to that day and not the next one.
TIMEZONE=America/New_York

# Set to true to drop the store password and sign in with a PIN only.
# Convenient on a counter device; keep the URL private and watch /access.
PIN_ONLY=false
